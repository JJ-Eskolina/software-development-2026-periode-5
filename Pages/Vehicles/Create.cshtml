@page
@model jj_eskolina_silver_enigma.Pages.Vehicles.CreateModel
@{
    ViewData["Title"] = "Voertuig Toevoegen";
    ViewData["Nav"] = "Vehicles";
}

<nav class="breadcrumb">
    <a asp-page="Index">Voertuigen</a> <span>&gt;</span> <strong>Toevoegen</strong>
</nav>
<form method="post">
<div class="card">
    <h3 class="card-title">Voertuiggegevens</h3>
    <div class="form-grid">
        <div class="form-field">
            <label>Voertuignaam</label>
            <input  asp-for="NewVehicle.Name" type="text" placeholder="Bijv. Mercedes Sprinter 316" />
        </div>
        <div class="form-field">
            <label>Kenteken</label>
            <input asp-for="NewVehicle.LicensePlate" type="text" placeholder="XX-123-YY" />
        </div>
        <div class="form-field">
            <label>Type</label>
            <select asp-for="NewVehicle.Type">
                <option>Minibus</option>
                <option>Stadsbus</option>
                <option>Touringcar</option>
            </select>
        </div>
        <div class="form-field">
            <label>Bouwjaar</label>
            <input asp-for="NewVehicle.Year" type="text" placeholder="2026" />
        </div>
        <div class="form-field">
            <label>Aantal Zitplaatsen</label>
            <input asp-for="NewVehicle.Seats" type="text" placeholder="16+1" />
        </div>
        <div class="form-field">
            <label>Brandstoftype</label>
            <select asp-for="NewVehicle.FuelType">
                <option>Diesel</option>
                <option>Elektrisch</option>
                <option>Hybride</option>
            </select>
        </div>
        <div class="form-field">
            <label>Huidige KM Stand</label>
            <input asp-for="NewVehicle.Mileage" type="text" placeholder="0 km" />
        </div>
        <div class="form-field">
            <label>Laatste APK Datum</label>
            <input asp-for="NewVehicle.LastInspection" type="text" placeholder="dd-mm-jjjj" />
        </div>
    </div>
</div>

<div class="form-actions">
    <a class="btn btn-outline" asp-page="Index">Annuleren</a>
    <button class="btn btn-primary" type="submit">Voertuig Opslaan</button>
</div>
</form>
