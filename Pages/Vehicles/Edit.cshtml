@page "{id:int}"
@model jj_eskolina_silver_enigma.Pages.Vehicles.EditModel
@{
    ViewData["Title"] = "Edit Vehicle";
    ViewData["Nav"] = "Vehicles";
}

<nav class="breadcrumb">
    <a asp-page="Index">Vehicle</a> <span>&gt;</span> <span>@Model.Vehicle.Name</span> <span>&gt;</span> <strong>Edit</strong>
</nav>

<div class="edit-grid">
    <div class="card">
        <h3 class="card-title">Vehicle Images</h3>
        @if (Model.Images.FirstOrDefault() is { } primaryImage)
        {
            <img class="vehicle-preview" src="@Url.Page("/Vehicles/Index", "Image", new { id = Model.Vehicle.Id, imageId = primaryImage.Id })" alt="@Model.Vehicle.Name" />
        }
        else if (!string.IsNullOrWhiteSpace(Model.Vehicle.ImageUrl))
        {
            <img class="vehicle-preview" src="@Model.Vehicle.ImageUrl" alt="@Model.Vehicle.Name" />
        }
        else
        {
            <div class="vehicle-preview vehicle-image-empty">Geen afbeelding</div>
        }

        <h4 class="gallery-title">Afbeeldingen uit SQLite</h4>
        <form method="post" asp-page-handler="UploadImages" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            <div class="form-field">
                <label asp-for="UploadedImages">Kies afbeeldingen (JPG, PNG, GIF of WebP; max. 5 MB per afbeelding)</label>
                <input asp-for="UploadedImages" type="file" accept="image/jpeg,image/png,image/gif,image/webp" multiple />
                <span asp-validation-for="UploadedImages" class="text-danger"></span>
            </div>
            <button class="btn btn-outline btn-block" type="submit">Afbeeldingen uploaden</button>
        </form>
        <div class="gallery-row">
            @foreach (var image in Model.Images)
            {
                <div class="gallery-image">
                    <img class="gallery-thumb" src="@Url.Page("/Vehicles/Index", "Image", new { id = Model.Vehicle.Id, imageId = image.Id })" alt="@image.FileName" />
                    <span>@image.FileName</span>
                    <form method="post" asp-page-handler="DeleteImage" asp-route-imageId="@image.Id"
                          onsubmit="return confirm('Deze afbeelding verwijderen?');">
                        <button class="btn btn-danger-outline btn-sm" type="submit">Verwijderen</button>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <h3 class="card-title">Vehicle Details</h3>
        <form method="post">
        <input type="hidden" asp-for="Vehicle.Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <div class="form-grid">
            <div class="form-field">
                <label>Vehicle Name</label>
                <input asp-for="Vehicle.Name" type="text" />
            </div>
            <div class="form-field">
                <label>License Plate</label>
                <input asp-for="Vehicle.LicensePlate" type="text" />
            </div>
            <div class="form-field">
                <label>Type</label>
                <select asp-for="Vehicle.Type">
                    <option>Minibus</option>
                    <option>City Bus</option>
                    <option>Coach</option>
                </select>
            </div>
            <div class="form-field">
                <label>Year</label>
                <input asp-for="Vehicle.Year" type="text" />
            </div>
            <div class="form-field">
                <label>Number of Seats</label>
                <input asp-for="Vehicle.Seats" type="text" />
            </div>
            <div class="form-field">
                <label>Fuel Type</label>
                <select asp-for="Vehicle.FuelType">
                    <option>Diesel</option>
                    <option>Electric</option>
                    <option>Hybrid</option>
                </select>
            </div>
            <div class="form-field">
                <label>Current Mileage</label>
                <input asp-for="Vehicle.Mileage" type="text" />
            </div>
            <div class="form-field">
                <label>Last Inspection Date</label>
                <input asp-for="Vehicle.LastInspection" type="text" />
            </div>
            <div class="form-field">
                <label asp-for="Vehicle.Status">Status</label>
                <select asp-for="Vehicle.Status">
                    <option>Beschikbaar</option>
                    <option>Verhuurd</option>
                    <option>In Onderhoud</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Vehicle.HasDamage">Heeft schade</label>
                <input asp-for="Vehicle.HasDamage" type="checkbox" />
            </div>
            <div class="form-field">
                <label asp-for="Vehicle.Damage">Schade beschrijving</label>
                <input asp-for="Vehicle.Damage" type="text" />
            </div>
        </div>

        <div class="form-actions">
            <a class="btn btn-outline" asp-page="Index">Cancel</a>
            <button class="btn btn-primary" type="submit">Save</button>
        </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Damage Registration</h3>
        <button class="btn btn-danger-outline" type="button">+ Report Damage</button>
    </div>
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Severity</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @* TODO: DamageHistory hoort bij een aparte 1-op-veel relatie (later toe te voegen). *@
                <tr><td colspan="4" class="empty-row">No damage registered.</td></tr>
            </tbody>
        </table>
    </div>
</div>
